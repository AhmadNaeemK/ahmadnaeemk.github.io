---
import RightNow from "../../components/RightNow.astro";
import type { SiteContent } from "../../content/assemble";
import { LIVERY_LABELS, LIVERY_ORDER, SPEEDS } from "../../rail";
import { sectionId } from "../../scene/contract";
import { LINES } from "./lines";
import {
  BRIDGE_BED_WIDTH,
  BRIDGE_CASING_WIDTH,
  BRIDGE_DECK_WIDTH,
  BRIDGE_GRADIENT_X,
  COMPACT_VIEW,
  LETTER_WIDTH,
  TUNNEL_DASH,
  TUNNEL_WIDTH,
  VIEW_WIDTH,
  VIEW_X0,
} from "./map-view";
import { STATIC_MAP_PATHS } from "./static-map";

interface Props {
  profile: SiteContent["profile"];
}

const { profile } = Astro.props;
const TICK_STEP_PX = 3;
const SHORTEST_TICK_PX = 5;
---

<section class="hero" data-rail-hero tabindex="-1" aria-label="Introduction">
  <div class="wrap">
    <div class="map" data-rail-scene-frame>
      <div class="map__scene">
        <canvas
          class="map__canvas"
          data-rail-canvas
          role="img"
          aria-label="A train runs along tracks shaped like the word ahmad, stopping at small stations where people get on and off."
        ></canvas>
        <div class="map__static" data-rail-static>
          <svg
            viewBox={`${VIEW_X0} ${COMPACT_VIEW.y0} ${VIEW_WIDTH} ${COMPACT_VIEW.height}`}
            preserveAspectRatio="xMidYMax meet"
            role="img"
            aria-label="Tracks shaped like the word ahmad, drawn as five transit lines."
          >
            <defs>
              <linearGradient
                id="a-static-bridge"
                gradientUnits="userSpaceOnUse"
                x1={BRIDGE_GRADIENT_X.from}
                y1="0"
                x2={BRIDGE_GRADIENT_X.to}
                y2="0"
              >
                <stop offset="0" style="stop-color: var(--tomato)"></stop>
                <stop offset="1" style="stop-color: var(--cobalt)"></stop>
              </linearGradient>
            </defs>
            <g
              fill="none"
              stroke="var(--track-under)"
              stroke-width={TUNNEL_WIDTH}
              stroke-linecap="round"
              stroke-dasharray={TUNNEL_DASH.join(" ")}
            >
              {STATIC_MAP_PATHS.tunnels.map((path) => (
                <path d={path} />
              ))}
            </g>
            <g
              fill="none"
              stroke-width={LETTER_WIDTH}
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              {STATIC_MAP_PATHS.letters.map((path, index) => (
                <path d={path} style={`stroke: var(--${LINES[index].color})`} />
              ))}
            </g>
            <g fill="none" stroke-linecap="round">
              <path
                d={STATIC_MAP_PATHS.bridge}
                stroke="var(--ink)"
                stroke-width={BRIDGE_CASING_WIDTH}
              ></path>
              <path
                d={STATIC_MAP_PATHS.bridge}
                stroke="var(--bg)"
                stroke-width={BRIDGE_BED_WIDTH}
              ></path>
              <path
                d={STATIC_MAP_PATHS.bridge}
                stroke="url(#a-static-bridge)"
                stroke-width={BRIDGE_DECK_WIDTH}
              ></path>
            </g>
          </svg>
        </div>
      </div>
      <div
        class="service"
        data-rail-controls
        role="group"
        aria-label="Train controls"
      >
        <button
          type="button"
          class="service__signal"
          data-rail-toggle
          aria-pressed="false"
        >
          <span class="lamp" aria-hidden="true"></span>
          <span data-rail-label>Stop the train</span>
        </button>
        <div class="service__group" role="group" aria-label="Speed">
          <span class="service__k" aria-hidden="true">
            Speed
          </span>
          {SPEEDS.map((_, index) => (
            <button
              type="button"
              class="tick"
              data-rail-speed={index}
              aria-label={`Speed ${index + 1} of ${SPEEDS.length}`}
              aria-pressed="false"
              style={`--h: ${SHORTEST_TICK_PX + index * TICK_STEP_PX}px`}
            />
          ))}
        </div>
        <div class="service__group" role="group" aria-label="Choose a train">
          <span class="service__k" aria-hidden="true">
            Train
          </span>
          {LIVERY_ORDER.map((id) => (
            <button
              type="button"
              class={`liv liv--${id}`}
              data-rail-livery={id}
              aria-label={LIVERY_LABELS[id]}
              aria-pressed="false"
              title={LIVERY_LABELS[id]}
            />
          ))}
        </div>
      </div>
      <RightNow />
    </div>

    <div class="intro">
      <h1 class="intro__name">{profile.name}</h1>
      <p class="intro__role">
        {profile.role}. {profile.focus}.
      </p>
      <p class="intro__text">{profile.intro}</p>
      <div class="intro__cta">
        <a class="btn btn--solid" href={profile.cv} download data-cv>
          Download CV
        </a>
        <a class="btn" href={`#${sectionId("interchange", "contact")}`}>
          Get in touch
        </a>
        <span class="intro__where">{profile.location}</span>
      </div>
      <p class="hint">Tap the train to stop it.</p>
    </div>
  </div>
</section>
