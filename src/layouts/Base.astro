---
import "./fallback-fonts.css";
import "./global.css";
import { getSiteContent } from "../content/site";
import {
  COLOR_SCHEME_ATTRIBUTE,
  DEFAULT_THEME,
  STORAGE_KEYS,
  THEME_ATTRIBUTE,
  THEME_BY_HASH,
  THEME_NAMES,
} from "../scene/contract";
import { THEME_META } from "../themes/registry";

interface Props {
  title: string;
  /** For a page with no address of its own, such as the 404 page. */
  noindex?: boolean;
}

const { title, noindex = false } = Astro.props;

const { profile } = await getSiteContent();
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL("/og-image.png", Astro.site);

// The head script is inline and synchronous, so the right theme is set before the
// first paint. Its rules match src/scene/theme.ts, which it cannot import. A saved
// value is looked up in the list, never as a table key: a table key such as
// "constructor" would find a function on the prototype. These notes sit here so
// they do not ship with the script.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={profile.intro} />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <link rel="canonical" href={canonicalUrl} />
    )}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={profile.intro} />
    {!noindex && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`${profile.name}. ${profile.role}. ${profile.focus}.`}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <script
      is:inline
      define:vars={{
        COLOR_SCHEME_ATTRIBUTE,
        DEFAULT_THEME,
        STORAGE_KEYS,
        THEME_ATTRIBUTE,
        THEME_BY_HASH,
        THEME_NAMES,
      }}
    >
      function readSaved(key) {
        try {
          return localStorage.getItem(key);
        } catch {
          return null;
        }
      }
      const html = document.documentElement;
      const savedTheme = readSaved(STORAGE_KEYS.theme);
      const savedScheme = readSaved(STORAGE_KEYS.colorScheme);
      const theme = Object.hasOwn(THEME_BY_HASH, location.hash)
        ? THEME_BY_HASH[location.hash]
        : THEME_NAMES.includes(savedTheme)
          ? savedTheme
          : DEFAULT_THEME;
      html.setAttribute(THEME_ATTRIBUTE, theme);
      if (savedScheme === "light" || savedScheme === "dark") {
        html.setAttribute(COLOR_SCHEME_ATTRIBUTE, savedScheme);
      }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <noscript>
      <link rel="stylesheet" href={THEME_META[DEFAULT_THEME].fontStylesheet} />
    </noscript>
  </head>
  <body>
    <slot />
  </body>
</html>
